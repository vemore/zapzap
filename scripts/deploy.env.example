# Copy to scripts/deploy.env (gitignored) and fill in. scripts/deploy_nas.sh sources it;
# a variable already set in the environment wins. A deploy worktree gets the main
# checkout's copy linked by `scripts/worktree_setup.sh --deploy`.

# The LAN registry both this machine and the NAS reach, host:port. Plain HTTP: it must be
# in "insecure-registries" of /etc/docker/daemon.json on both, and both `docker login` it.
REGISTRY=192.168.1.25:5050

# SSH destination of the NAS (user@host, or an alias of ~/.ssh/config).
NAS_SSH=vemore@192.168.1.147

# The deploy directory on the NAS: compose.yaml (written by the script), the production
# .env (secrets, placed there by hand, never printed) and data/ (the database).
NAS_DEPLOY_DIR=/home/vemore/docker/zapzap

# The public URL, only echoed at the end of a deploy for the checks of the deploy skill.
PUBLIC_URL=https://zapzap.ombivince.synology.me

# The Google web OAuth client id baked into the React and Flutter images (not a secret).
# Optional here: when unset, the script reads VITE_GOOGLE_OAUTH_CLIENT_ID from the
# repository's .env. It refuses to build without one.
# VITE_GOOGLE_OAUTH_CLIENT_ID=
