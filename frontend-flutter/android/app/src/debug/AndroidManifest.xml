<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug only: allow plain HTTP so a local backend works
         (API_BASE_URL=http://10.0.2.2:9999 from the emulator, or the LAN IP).
         The main manifest sets no network security config: profile and release
         builds keep Android's default, HTTPS only. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
