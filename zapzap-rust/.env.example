# Server Configuration
PORT=9999

# Database
DATABASE_URL=sqlite:./data/zapzap.db

# Authentication — required: the server refuses to start without it, or with a placeholder
# published in this repository. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Logging
RUST_LOG=zapzap_backend=debug,tower_http=debug

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=your-google-client-id
