# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Playwright report files
playwright-report/

# Test results
test-results/
# Left in a main checkout by the removed Playwright suite (tests/e2e)
tests/e2e/results/

# Database
data/zapzap.db
# Left in a main checkout by the removed Node test suites
data/zapzap.test.db
# Backups the deploy skill takes before a deploy (data/zapzap.db.bak-<date>)
data/*.db.bak-*
# The LLM bot's memory (BOT_STRATEGIES_DIR), written at runtime
data/bot-strategies/

# Playwright MCP screenshots
.playwright-mcp/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test
# scripts/deploy_nas.sh's configuration (copy scripts/deploy.env.example)
scripts/deploy.env

# parcel-bundler cache (https://parceljs.org/)
.cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and *not* Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Rust / Cargo
native/target/
native/Cargo.lock
native/*.node
**/*.rs.bk

# Rust backend (zapzap-rust)
zapzap-rust/target/
# zapzap-rust/Cargo.lock is committed: the image build copies it and CI runs --locked.

# Flutter client (frontend-flutter/.gitignore has the rest)
frontend-flutter/build/
frontend-flutter/.dart_tool/

# NAPI-RS build artifacts
native/artifacts/

# DRL model checkpoints (large binary files)
data/models/*.safetensors

# Google OAuth credentials (secrets), wherever a download lands (the Node backend kept
# them under src/infrastructure/auth/, which a main checkout may still hold untracked)
client_secret_*.json

# Local work tracking: one file per entry, never committed (scripts/wip.sh, .llmwiki/ParallelDelivery.md)
/wip/

# scripts/worktree_setup.sh marker (cleanup_local.sh keeps a worktree that has one)
/.zapzap-setup-in-progress
