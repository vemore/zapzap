# ZapZap Environment Variables (root docker-compose.yml)
#
# The `backend` service is the Rust backend (zapzap-rust/). NODE_ENV, LOG_LEVEL and
# LOG_DIR, left from the Node backend (removed), are read by nothing: a production .env can
# drop them. The database path is set by docker-compose.yml.

# JWT Configuration (REQUIRED, no default: docker-compose refuses to start without it, and
# the backend refuses the placeholder below). Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string

# Logging (tracing filter, e.g. `warn`, `info`, `info,zapzap_backend=debug`)
RUST_LOG=info

# Proxy Configuration
PROXY_PORT=80

# ====================================
# Optional Advanced Configuration
# ====================================

# Browser origins the API answers cross-origin, comma-separated (scheme://host[:port]).
# Unset: every origin, for development. docker-compose.prod.yml defaults it to the
# production domain; a malformed entry stops the backend at startup.
# ALLOWED_ORIGINS=https://zapzap.example,http://localhost:5173

# Pause between two bot actions, in ms (default: 1000)
# BOT_ACTION_DELAY_MS=1000

# Google sign-in: the backend verifies ID tokens for this client id; the Flutter PWA is
# built with VITE_GOOGLE_OAUTH_CLIENT_ID (a name the removed React client gave it).
# Unset: no Google login.
# GOOGLE_OAUTH_CLIENT_ID=
# VITE_GOOGLE_OAUTH_CLIENT_ID=

# ====================================
# AWS Bedrock Configuration (for LLM Bot)
# ====================================
# Passed to the backend only when set here. When AWS_BEDROCK_ENABLED is present it decides
# alone (empty, `false` or `0` = off); absent, AWS_ACCESS_KEY_ID set turns Bedrock on.

# AWS_BEDROCK_ENABLED=true

# AWS Region for Bedrock (default: us-east-1). It must serve the model: gpt-oss-120b is
# served on demand in us-east-1, us-east-2, eu-west-1, eu-central-1, ap-northeast-1,
# ap-south-1 and ap-southeast-2 — not in eu-west-3 (checked 2026-09-29).
# AWS_BEDROCK_REGION=us-east-1

# Bedrock Model ID (default: OpenAI gpt-oss-120b). The backend calls the Converse API, so
# any Converse model works with no code change. Llama 3.3 70B, the model before
# 2026-09-29, is reached only through its inference profile (the bare id is refused on demand):
# AWS_BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
# AWS_BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0

# AWS Credentials
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=
