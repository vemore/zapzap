# ZapZap Environment Variables (root docker-compose.yml)
#
# The `backend` service is the Rust backend (zapzap-rust/). Node-only keys (NODE_ENV,
# ALLOWED_ORIGINS, LOG_LEVEL, LOG_DIR, DB_PATH) are read only by the Node backend, which a
# rollback to the commit before the switch runs again (.llmwiki/Deployment.md): keep them in
# a production .env until that rollback is no longer wanted.

# JWT Configuration (REQUIRED, no default: docker-compose refuses to start without it, and
# the backend refuses the placeholder below). Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string

# Logging (tracing filter, e.g. `warn`, `info`, `info,zapzap_backend=debug`)
RUST_LOG=info

# Proxy Configuration
PROXY_PORT=80

# ====================================
# Optional Advanced Configuration
# ====================================

# Pause between two bot actions, in ms (default: 1000)
# BOT_ACTION_DELAY_MS=1000

# Google sign-in: the backend verifies ID tokens for this client id; the two clients are
# built with VITE_GOOGLE_OAUTH_CLIENT_ID. Unset: no Google login.
# GOOGLE_OAUTH_CLIENT_ID=
# VITE_GOOGLE_OAUTH_CLIENT_ID=

# ====================================
# AWS Bedrock Configuration (for LLM Bot)
# ====================================
# Passed to the backend only when set here. When AWS_BEDROCK_ENABLED is present it decides
# alone (empty, `false` or `0` = off); absent, AWS_ACCESS_KEY_ID set turns Bedrock on.

# AWS_BEDROCK_ENABLED=true

# AWS Region for Bedrock (default: us-east-1)
# AWS_BEDROCK_REGION=us-east-1

# Bedrock Model ID (default: Llama 3.3 70B Instruct)
# AWS_BEDROCK_MODEL_ID=meta.llama3-3-70b-instruct-v1:0

# AWS Credentials
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=
